// PersonalityDao.kt
package com.xos.personalsystem.data.local.dao

import androidx.room.*
import com.xos.personalsystem.data.local.entities.PersonalityEntity
import kotlinx.coroutines.flow.Flow

@Dao
interface PersonalityDao {
    @Query("SELECT * FROM personalities ORDER BY orderIndex ASC")
    fun getAll(): Flow<List<PersonalityEntity>>

    @Query("SELECT * FROM personalities WHERE id = :id")
    suspend fun getById(id: String): PersonalityEntity?

    @Query("SELECT * FROM personalities WHERE type = 'XOS'")
    suspend fun getXOS(): PersonalityEntity?

    @Query("SELECT * FROM personalities WHERE isActive = 1")
    suspend fun getActive(): PersonalityEntity?

    @Insert
    suspend fun insert(personality: PersonalityEntity): Long

    @Update
    suspend fun update(personality: PersonalityEntity)

    @Delete
    suspend fun delete(personality: PersonalityEntity)

    @Query("UPDATE personalities SET isActive = 0")
    suspend fun clearActive()

    @Query("UPDATE personalities SET isActive = 1 WHERE id = :id")
    suspend fun setActive(id: String)
}

