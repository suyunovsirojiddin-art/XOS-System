// PersonalityEntity.kt
package com.xos.personalsystem.data.local.entities

import androidx.room.Entity
import androidx.room.PrimaryKey
import java.util.UUID

@Entity(tableName = "personalities")
data class PersonalityEntity(
    @PrimaryKey
    val id: String = UUID.randomUUID().toString(),
    val name: String,
    val type: String, // "XOS" or "NORMAL"
    val isActive: Boolean = false,
    val orderIndex: Int = 0,
    val createdAt: Long = System.currentTimeMillis(),
    val updatedAt: Long = System.currentTimeMillis()
)

// GoalEntity.kt
@Entity(tableName = "goals")
data class GoalEntity(
    @PrimaryKey
    val id: String = UUID.randomUUID().toString(),
    val personalityId: String,
    val name: String,
    val description: String = "",
    val orderIndex: Int = 0,
    val deadline: Long = 0,
    val isCompleted: Boolean = false,
    val completedAt: Long = 0,
    val isActive: Boolean = true,
    val createdAt: Long = System.currentTimeMillis(),
    val updatedAt: Long = System.currentTimeMillis()
)

// LevelEntity.kt
@Entity(tableName = "levels")
data class LevelEntity(
    @PrimaryKey
    val id: String = UUID.randomUUID().toString(),
    val goalId: String,
    val levelNumber: Int,
    val name: String = "",
    val description: String = "",
    val requiredTasksCount: Int = 1,
    val orderIndex: Int = 0,
    val isActive: Boolean = true,
    val createdAt: Long = System.currentTimeMillis(),
    val updatedAt: Long = System.currentTimeMillis()
)

// TaskEntity.kt
@Entity(tableName = "tasks")
data class TaskEntity(
    @PrimaryKey
    val id: String = UUID.randomUUID().toString(),
    val levelId: String,
    val title: String,
    val description: String = "",
    val taskType: String, // "THEORETICAL" or "PRACTICAL"
    val difficulty: String, // "EASY", "MEDIUM", "HARD", "EXPERT"
    val estimatedDuration: Int = 30, // minutes
    val deadline: Long = 0,
    val isRequired: Boolean = true,
    val requiresAIVerification: Boolean = false,
    val recurrence: String = "ONCE", // "ONCE", "DAILY", "WEEKLY"
    val aiVerificationPrompt: String = "",
    val isActive: Boolean = true,
    val createdAt: Long = System.currentTimeMillis(),
    val updatedAt: Long = System.currentTimeMillis()
)

// TaskCompletionEntity.kt
@Entity(tableName = "task_completions")
data class TaskCompletionEntity(
    @PrimaryKey
    val id: String = UUID.randomUUID().toString(),
    val taskId: String,
    val personalityId: String,
    val completionDate: Long = System.currentTimeMillis(),
    val status: String, // "PENDING", "PASSED", "FAILED", "SKIPPED"
    val aiVerificationResult: String = "",
    val aiVerificationScore: Float = 0f,
    val attemptsCount: Int = 0,
    val lastAttemptDate: Long = 0,
    val createdAt: Long = System.currentTimeMillis()
)

// ProgressionEntity.kt
@Entity(tableName = "progressions")
data class ProgressionEntity(
    @PrimaryKey
    val id: String = UUID.randomUUID().toString(),
    val personalityId: String,
    val goalId: String,
    val levelId: String,
    val progressPercentage: Float = 0f,
    val completedTasksCount: Int = 0,
    val totalTasksCount: Int = 0,
    val currentStreak: Int = 0,
    val highestStreak: Int = 0,
    val consecutiveFailures: Int = 0,
    val totalFailures: Int = 0,
    val levelDrops: Int = 0,
    val highestLevelReached: Int = 0,
    val currentLevelNumber: Int = 1,
    val isWarningActive: Boolean = false,
    val updatedAt: Long = System.currentTimeMillis(),
    val createdAt: Long = System.currentTimeMillis()
)

// ProgressionHistoryEntity.kt
@Entity(tableName = "progression_history")
data class ProgressionHistoryEntity(
